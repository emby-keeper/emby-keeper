# 复制为 .env 后修改: cp .env.example .env
# docker compose 会自动读取当前目录下的 .env

# [必填] 面板访问密码, 必须将示例值替换为自己的密码
EK_WEBPASS=your-password

# [可选] 面板对外端口, 浏览器访问 http://<服务器地址>:<该端口>
EK_PANEL_PORT=8000

# [可选] 镜像版本
EK_PANEL_IMAGE=embykeeper/embykeeper:latest

# [可选] 容器运行用户, 默认 0:0 (root, 与旧版镜像一致).
# 设为宿主机用户 (例如 EK_PUID=1000 / EK_PGID=1000) 时, ./data 内的文件将归属该用户,
# 便于在宿主机上直接备份或编辑; 请先确保 ./data 目录归属一致, 否则会写入失败.
EK_PUID=0
EK_PGID=0

